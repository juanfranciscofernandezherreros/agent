# GitLab: grupo que se analizará al ejecutar run-analysis.bat
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_GROUP_ID=

# Opcionales
# Nombre contextual del análisis. Si se deja vacío, se genera automáticamente.
ANALYSIS_NAME=
# Carpeta de destino de los informes descargados.
REPORT_DIR=reports
# Días de histórico para ramas recientes, commits y pushes.
ACTIVITY_DAYS=90

# Agentes inteligentes (opcional). Con true, se envían al proveedor LLM resultados del análisis
# y fragmentos de código redactados para interpretación funcional, revisión de bugs,
# explicación arquitectónica y correlación de evidencias.
LLM_AGENTS_ENABLED=false

# Proveedor LLM (no es necesario para el análisis estático básico)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1

# Alternativa local con Ollama:
# LLM_PROVIDER=ollama
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5-coder:14b
# LLM_BASE_URL=http://127.0.0.1:11434/v1
