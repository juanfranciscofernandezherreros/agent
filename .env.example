# GitLab: grupo que se analizará al ejecutar run-analysis.bat
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_GROUP_ID=

# Opcionales
# Nombre contextual del análisis. Si se deja vacío, se genera automáticamente.
ANALYSIS_NAME=
# Carpeta de destino de los informes descargados.
REPORT_DIR=reports
# Reutiliza el análisis de los repositorios que no han cambiado (mismo commit). false para rehacer todo.
ANALYSIS_CACHE=true
# Días de histórico para ramas recientes, commits y pushes.
ACTIVITY_DAYS=90

# Agentes inteligentes (opcional). Con true, se envían al proveedor LLM resultados del análisis
# y fragmentos de código redactados para interpretación funcional, revisión de bugs,
# explicación arquitectónica y correlación de evidencias.
LLM_AGENTS_ENABLED=false

# --- Proveedor y modelo de los agentes LLM (solo se usan si LLM_AGENTS_ENABLED=true) ---
# Proveedor: openai | claude | gemini | ollama
LLM_PROVIDER=openai
# Modelo: el identificador exacto en ese proveedor. Los modelos cambian a menudo; para ver los que
# ofrece tu cuenta ejecuta:  run-analysis.bat -ListModels   (o  python -m app.llm --models)
# Ejemplos: gpt-6-luna (OpenAI), claude-sonnet-5-5 (Claude), gemini-3.6-flash (Gemini), qwen2.5-coder:14b (Ollama)
LLM_MODEL=

# Claves: rellena la del proveedor que uses. Puedes dejar varias y cambiar solo LLM_PROVIDER y LLM_MODEL.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Clave genérica: se usa si falta la específica del proveedor elegido.
LLM_API_KEY=

# Ollama no necesita clave. URL del servidor local:
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Solo para OpenAI o servicios compatibles con su API (déjalo vacío para usar api.openai.com):
LLM_BASE_URL=

# Opcionales
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_SECONDS=120
# LLM_TEMPERATURE=0
